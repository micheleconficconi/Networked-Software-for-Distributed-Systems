    {
        "id": "6bde4ead2428d758",
        "type": "function",
        "z": "f742edae034f0ad0",
        "name": "ParserFunction",
        "func": "delete msg.ts;\ndelete msg.transport;\nmsg.payload.inbound = false;\nmsg.payload.fallback = null;\n\nlet array = msg.payload.content.split(' ');\n\nif(array.length >3){ //if the city name contains a space, we reconstruct it in a single string\n    let unifiedArray = \"\";\n    for(let i =1; i<array.length -1; i++){\n        unifiedArray = unifiedArray + \" \" + array[i];\n    }\n    array = [array[0], unifiedArray, array[array.length-1]];\n} //when the professor said that it is not necessary we already added this\n\nif (msg.payload.content.match(\"QUERY \")){\n    msg.location = {\n        country : array[2],\n        city : array[1]\n    }\n    return [msg, null];\n} else if (msg.payload.content.match(\"TRACK \")) {\n    let map = flow.get(\"track\");\n    if(!map.has(msg.payload.chatId)){\n        map.set(msg.payload.chatId, []);\n    }\n\n    let insert = {\n        country: array[2],\n        city: array[1]\n    }\n\n    let value = map.get(msg.payload.chatId);\n    value.push(insert);\n    map.set(msg.payload.chatId, value);\n\n    flow.set(\"track\", map);\n    msg.payload = array[1];\n    return [null, msg];\n\n} else if (msg.payload.content.match(\"REPORT\")) {\n    let map = flow.get(\"track\");\n    let value = map.get(msg.payload.chatId);\n    for(let i in value){\n        msg.location = {\n            country : value[i].country,\n            city : value[i].city\n        }\n        node.send([msg, null]);\n    }\n} else { //no error handling \n    return [null, null];\n}\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\nflow.set(\"track\", new Map);",
